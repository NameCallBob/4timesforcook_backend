# Copy this file to .env and fill in the values for your environment.
# The .env file is gitignored; .env.example is committed as documentation.

# Django secret key. Required when DJANGO_DEBUG is off.
DJANGO_SECURE=change-me-to-a-long-random-string

# Debug flag. "1" enables debug mode, anything else disables it.
DJANGO_DEBUG=1

# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database engine: "sqlite" (default, dev) or "mysql" (production).
DB_ENGINE=sqlite

# MySQL connection settings (only used when DB_ENGINE=mysql).
SERVER_DATABASE=your_database_name
SERVER_USER=your_database_user
SERVER_PWD=your_database_password
SERVER_IP=127.0.0.1
SERVER_PORT=3306
